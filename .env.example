# `autojoinquant config add <alias>` creates one protected copy per account.
# This file is only a reference; do not source or commit real values.
JOINQUANT_USERNAME=
JOINQUANT_PASSWORD=
# Each alias receives an isolated profile automatically.
# Use auto unless a fixed debug port is required.
# JOINQUANT_DEBUG_PORT=auto
# Set to 1 for CLI-only hosts; Linux without DISPLAY/WAYLAND_DISPLAY enables it automatically.
# JOINQUANT_HEADLESS=1
# Optional: auto-detected when omitted. On NixOS this can be /run/current-system/sw/bin/chromium.
# JOINQUANT_CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# JOINQUANT_NODE_BIN=/path/to/node
# JOINQUANT_PYTHON=
# JOINQUANT_UV=uv
# JOINQUANT_TIMEOUT_MS=15000
# Maximum wait per page/login/verification/check-in phase.
# JOINQUANT_PAGE_READY_TIMEOUT_MS=60000
# Let page handlers and animations settle before submitting actions.
# JOINQUANT_ACTION_DELAY_MS=1000
